{
  // Un solo tsconfig para todo el proyecto (decisión #63): src/, data/ y
  // vite.config.ts. Sin baseUrl (deprecado en TS 6): los paths relativos
  // resuelven contra este archivo.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Opciones declaradas explícitamente porque su default cambió (o cambia)
    // en TS 6: no depender del default (foundation.md p.3).
    "types": ["vite/client", "node"],
    // true: los tipos de @testing-library/jest-dom 7 y Vitest 5 declaran
    // `Assertion` con type parameters incompatibles entre sus propios `.d.ts`
    // de terceros (TS2428). El flag no es requisito del kit ni lo fija
    // docs/README.md; el código propio (src/, data/, vite.config.ts) se sigue
    // chequeando contra esos tipos.
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "resolveJsonModule": true,

    "paths": {
      "@data/*": ["./data/*"]
    }
  },
  "include": ["src", "data", "vite.config.ts"]
}
