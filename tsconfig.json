{
  // A single tsconfig for the whole project: src/, data/ and vite.config.ts.
  // No baseUrl (deprecated in TS 6): the relative paths resolve against
  // this file.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Options declared explicitly because their default changed (or changes)
    // in TS 6: never rely on the defaults here.
    "types": ["vite/client", "node"],
    // true: the types of @testing-library/jest-dom 7 and Vitest 5 declare
    // `Assertion` with type parameters incompatible between their own
    // third-party `.d.ts` files (TS2428). The flag is not a requirement of the
    // kit and docs/README.md does not fix it; the project's own code (src/,
    // data/, vite.config.ts) is still checked against those types.
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "resolveJsonModule": true,

    "paths": {
      "@data/*": ["./data/*"]
    }
  },
  "include": ["src", "data", "vite.config.ts"]
}
