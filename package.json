{
  "name": "cv-agentic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "json2ts -i data/cv.schema.json -o data/cv.types.generated.ts --bannerComment=\"/* GENERADO — no editar. Regenerar con: npm run gen:types */\"",
    "build:validator": "node src/scripts/build-validator.ts",
    "validate:content": "node src/scripts/validate-content.ts",
    "prebuild": "npm run gen:types && npm run build:validator && npm run validate:content",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource/poppins": "^5",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "simple-icons": "^16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "ajv": "^8",
    "axe-core": "^4",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0.5",
    "jsdom": "^30",
    "json-schema-to-typescript": "^16",
    "typescript": "~6.0",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
