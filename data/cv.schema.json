{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cv-agentic.local/data/cv.schema.json",
  "title": "CvData",
  "description": "CV content for one language (cv.en.json / cv.es.json). Source of truth for the format: the TypeScript types are generated from this file (data/cv.types.generated.ts). Fields marked 'Not translatable' must be identical across languages (content.test.ts checks it).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locale",
    "profile",
    "contact",
    "social",
    "services",
    "education",
    "experience",
    "projects",
    "skills",
    "testimonials"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this schema, for autocompletion and validation in the editor. Not used by the app."
    },
    "locale": {
      "$ref": "#/definitions/Locale"
    },
    "profile": {
      "$ref": "#/definitions/Profile"
    },
    "contact": {
      "type": "array",
      "description": "Sidebar contact details, in display order.",
      "items": {
        "$ref": "#/definitions/ContactItem"
      }
    },
    "social": {
      "type": "array",
      "description": "Sidebar social links, in display order.",
      "items": {
        "$ref": "#/definitions/SocialLink"
      }
    },
    "services": {
      "type": "array",
      "description": "Cards of 'What I'm Doing' in the About panel.",
      "items": {
        "$ref": "#/definitions/Service"
      }
    },
    "education": {
      "type": "array",
      "description": "Education timeline (data order = display order).",
      "items": {
        "$ref": "#/definitions/TimelineEntry"
      }
    },
    "experience": {
      "type": "array",
      "description": "Experience timeline (data order = display order).",
      "items": {
        "$ref": "#/definitions/TimelineEntry"
      }
    },
    "projects": {
      "type": "array",
      "description": "Projects timeline: personal projects, apart from work experience (data order = display order).",
      "items": {
        "$ref": "#/definitions/TimelineEntry"
      }
    },
    "skills": {
      "type": "array",
      "description": "Flat list of chips, in display order. No percentages or categories.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "testimonials": {
      "type": "array",
      "description": "Carousel testimonials (no date).",
      "items": {
        "$ref": "#/definitions/Testimonial"
      }
    }
  },
  "definitions": {
    "Locale": {
      "title": "Locale",
      "description": "Language of the file. Must match its name (cv.<locale>.json). Differs between files by definition (it is left out of the parity comparison).",
      "type": "string",
      "enum": [
        "en",
        "es"
      ]
    },
    "Id": {
      "title": "Id",
      "description": "Stable identifier, lowercase with hyphens. Not translatable.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "PublicPath": {
      "title": "PublicPath",
      "description": "Public path of the site (starts with /) or an https URL. Not translatable.",
      "type": "string",
      "pattern": "^(/|https://)\\S+$"
    },
    "YearMonth": {
      "title": "YearMonth",
      "description": "Date as \"YYYY\" or \"YYYY-MM\" (year 1900–2099, month 01–12). Not translatable.",
      "type": "string",
      "pattern": "^(19|20)\\d{2}(-(0[1-9]|1[0-2]))?$"
    },
    "Image": {
      "title": "Image",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "$ref": "#/definitions/PublicPath"
        }
      }
    },
    "TestimonialAvatar": {
      "title": "TestimonialAvatar",
      "description": "Testimonial avatar: src only. It is decorative (alt=\"\") because the name is next to it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "$ref": "#/definitions/PublicPath"
        }
      }
    },
    "Profile": {
      "title": "Profile",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "headline",
        "avatar",
        "about"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Full name."
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "description": "Role shown in the Sidebar badge. E.g. \"Frontend Developer\"."
        },
        "avatar": {
          "$ref": "#/definitions/Image"
        },
        "about": {
          "type": "array",
          "description": "Paragraphs of the About panel.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "downloadCvUrl": {
          "$ref": "#/definitions/PublicPath",
          "description": "URL of the CV PDF (not translatable for now; see docs/BACKLOG.md). If missing, the Download CV button is not shown."
        }
      }
    },
    "ContactType": {
      "title": "ContactType",
      "description": "Closed list: adding a type requires code (icon and interface label). Not translatable.",
      "type": "string",
      "enum": [
        "email",
        "phone",
        "whatsapp",
        "location"
      ]
    },
    "ContactItem": {
      "title": "ContactItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "type": {
          "$ref": "#/definitions/ContactType"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Visible value. E.g. \"hello@example.com\", \"Buenos Aires, Argentina\"."
        },
        "href": {
          "type": "string",
          "pattern": "^(https?://|mailto:|tel:|/)\\S+$",
          "description": "Link target (not translatable). If missing it is derived from the type: email → mailto:, phone → tel:, whatsapp → https://wa.me/<digits>, location → no link."
        }
      }
    },
    "SocialNetwork": {
      "title": "SocialNetwork",
      "description": "Closed list: adding a network requires code (logo in BrandIcon). Not translatable.",
      "type": "string",
      "enum": [
        "github",
        "linkedin",
        "x",
        "instagram",
        "facebook",
        "dribbble",
        "behance"
      ]
    },
    "SocialLink": {
      "title": "SocialLink",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "network",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "network": {
          "$ref": "#/definitions/SocialNetwork"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$",
          "description": "Profile URL (https). Not translatable."
        }
      }
    },
    "ServiceIcon": {
      "title": "ServiceIcon",
      "description": "Closed list of lucide-react icons: adding one requires code (Icon map). Not translatable.",
      "type": "string",
      "enum": [
        "code",
        "layout",
        "palette",
        "smartphone",
        "server",
        "database",
        "cloud",
        "pen-tool",
        "camera",
        "megaphone",
        "gauge",
        "shield"
      ]
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "icon"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/definitions/ServiceIcon"
        }
      }
    },
    "TimelineEntry": {
      "title": "TimelineEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "organization",
        "start",
        "end",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Degree (Education), position (Experience) or project name (Projects)."
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "description": "Institution, company or, in Projects, the project's context."
        },
        "start": {
          "$ref": "#/definitions/YearMonth"
        },
        "end": {
          "description": "End date (\"YYYY\" or \"YYYY-MM\") or null if ongoing (\"Present\" / \"Actualidad\"). Not translatable.",
          "oneOf": [
            {
              "$ref": "#/definitions/YearMonth"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Testimonial": {
      "title": "Testimonial",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "author",
        "role",
        "avatar",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "description": "Person's name (normally the same in both languages)."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Author's role and company."
        },
        "avatar": {
          "$ref": "#/definitions/TestimonialAvatar"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Full text; the card shows an excerpt clamped with CSS."
        }
      }
    }
  }
}
